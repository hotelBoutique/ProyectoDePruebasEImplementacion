{
  "name": "hotel-management-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "test:unit:report": "jest --config jest.config.cjs --runInBand --coverage --coverageReporters=text --coverageReporters=lcov --json --outputFile=coverage/jest-unit-results.json",
    "test:unit:watch": "jest --config jest.config.cjs --watch",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:config": "node --test tests/e2e/runConfig.test.js",
    "test:e2e:login": "jest --config jest.e2e.config.cjs --runInBand tests/e2e/login.e2e.test.js",
    "test:e2e:rooms": "jest --config jest.e2e.config.cjs --runInBand tests/e2e/rooms-availability.e2e.test.js",
    "test:e2e:reception": "jest --config jest.e2e.config.cjs --runInBand tests/e2e/reception-flow.e2e.test.js",
    "test:e2e:suite": "jest --config jest.e2e.config.cjs --runInBand",
    "test:e2e:suite:report": "node -e \"require('node:fs').mkdirSync('reports/e2e',{recursive:true})\" && jest --config jest.e2e.config.cjs --runInBand --json --outputFile=reports/e2e/jest-results.json",
    "dev:e2e": "vite --mode e2e --port 5174",
    "dev:uat": "vite --mode uat --host 127.0.0.1 --port 5174 --strictPort",
    "test:uat:config": "node --test tests/e2e/uatLocalConfig.test.js",
    "test:uat:smoke": "node -e \"require('node:fs').mkdirSync('reports/uat',{recursive:true})\" && jest --config jest.uat.config.cjs --runInBand tests/e2e/uat/smoke.uat.test.js --json --outputFile=reports/uat/smoke-results.json",
    "test:uat:sanity": "node -e \"require('node:fs').mkdirSync('reports/uat',{recursive:true})\" && jest --config jest.uat.config.cjs --runInBand tests/e2e/uat/sanity.uat.test.js --json --outputFile=reports/uat/sanity-results.json",
    "test:uat": "npm run test:uat:config && npm run test:uat:smoke && npm run test:uat:sanity"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "selenium-webdriver": "^4.38.0",
    "vite": "^7.0.0"
  }
}
