# Perfil UAT de uso exclusivamente local. Copiar como frontend/.env.uat.
# La configuración UAT rechaza hosts remotos y exige MongoDB local con una base *_test.
VITE_BACKEND_URL=http://127.0.0.1:3000
TEST_API_URL=http://127.0.0.1:3000
TEST_APP_URL=http://127.0.0.1:5174

TEST_ADMIN_EMAIL=uat-admin@hotel.test
TEST_ADMIN_PASSWORD=Local-Uat-Admin-2026!
TEST_RECEPTION_EMAIL=uat-reception@hotel.test
TEST_RECEPTION_PASSWORD=Local-Uat-Reception-2026!
TEST_RECEPTION_NAME=Recepcionista UAT

SELENIUM_HEADLESS=true
