# Plantilla de configuración de las pruebas E2E (Selenium).
# Copia este archivo como frontend/.env.e2e y completa las credenciales.
# Git ignora frontend/.env.e2e; nunca subas credenciales al repositorio.
# Usa solo la API de QA: estas cuentas deben existir únicamente en proyectoSemestre_pruebas.

# API a la que el frontend de pruebas reenvía /api y /health (vite --mode e2e)
# VITE_BACKEND_URL=https://hotel-boutique-api-pruebas.onrender.com
VITE_BACKEND_URL=http://localhost:3000

# Dirección del frontend que abre Selenium (npm run dev:e2e)
TEST_APP_URL=http://localhost:5174

# API usada para despertar el servicio y comprobar la revocación de tokens
TEST_API_URL=http://localhost:3000

# Administrador de QA
TEST_ADMIN_EMAIL=admin@hotel.com
TEST_ADMIN_PASSWORD=HotelAdmin-2026-R7xQ!m4
# Primera palabra del nombre de la cuenta (se ve en "Hola, <nombre>.")
TEST_ADMIN_NAME=Administrador

# Recepcionista de QA
TEST_RECEPTION_EMAIL=paula@hotel.com
TEST_RECEPTION_PASSWORD=HotelAdmin-2026-R7xQ!m4
TEST_RECEPTION_NAME=Recepción

# Opcional: "false" para ver el navegador mientras corre la suite
SELENIUM_HEADLESS=false
